# Copy to .env and fill in. .env is git-ignored.

# --- App ---------------------------------------------------------------------
PROJECT_NAME="LeadPilot API"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Security ----------------------------------------------------------------
# Must be at least 32 bytes for HS256 (RFC 7518).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256

# Vite dev server origins, comma separated.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leadpilot

# Overrides the assembled Postgres URL. For a zero-setup local run:
# DATABASE_URL=sqlite+aiosqlite:///./leadpilot.db
# DATABASE_URL=

SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
