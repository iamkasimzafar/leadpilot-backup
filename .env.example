# Copy to .env and fill in. .env is git-ignored.

# --- App ---------------------------------------------------------------------
PROJECT_NAME="LeadPilot API"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Security ----------------------------------------------------------------
# Must be at least 32 bytes for HS256 (RFC 7518).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256

# Vite dev server origins, comma separated.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ----------------------------------------------------------------
# Base URL used to build emailed links (password reset, email verification).
FRONTEND_URL=http://localhost:5173

# --- Email (SMTP) ------------------------------------------------------------
# Leave EMAIL_ENABLED=false to skip real sending: messages are written to the
# log instead, so reset/verification links are usable without credentials.
EMAIL_ENABLED=false

# Gmail: SMTP_PASSWORD must be a 16-character App Password, NOT the account
# password. Requires 2-Step Verification, then:
#   https://myaccount.google.com/apppasswords
# Gmail rewrites the From header to the authenticated user, so leave
# EMAIL_FROM_ADDRESS blank to use SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT=15
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LeadPilot

# --- Database (MySQL) --------------------------------------------------------
# MySQL listens on the server's loopback only. For local development, open the
# SSH tunnel first (.\scripts\tunnel.ps1); 127.0.0.1:3306 then forwards to it.
# Use 172.17.0.1 only when running inside a Docker container ON the server.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=leadpilot

# Overrides the assembled MySQL URL. For a zero-setup local run:
# DATABASE_URL=sqlite+aiosqlite:///./leadpilot.db
# DATABASE_URL=

SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
