# Copy to .env and fill in. .env is git-ignored.

# --- App ---------------------------------------------------------------------
PROJECT_NAME="LeadPilot API"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Security ----------------------------------------------------------------
# Must be at least 32 bytes for HS256 (RFC 7518).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256

# Vite dev server origins, comma separated.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ----------------------------------------------------------------
# Base URL used to build emailed links (password reset, email verification).
FRONTEND_URL=http://localhost:5173

# --- Email (SMTP) ------------------------------------------------------------
# Leave EMAIL_ENABLED=false to skip real sending: messages are written to the
# log instead, so reset/verification links are usable without credentials.
EMAIL_ENABLED=false

# Gmail: SMTP_PASSWORD must be a 16-character App Password, NOT the account
# password. Requires 2-Step Verification, then:
#   https://myaccount.google.com/apppasswords
# Gmail rewrites the From header to the authenticated user, so leave
# EMAIL_FROM_ADDRESS blank to use SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT=15
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LeadPilot

# --- DeepSeek (AI keyword expansion) -----------------------------------------
# Create a key at https://platform.deepseek.com/api_keys
# Leave empty to disable: the Lead Radar expand endpoint then answers 503.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=45

# --- n8n (lead search workflow) -----------------------------------------------
# Full webhook URL. Use /webhook-test/<path> while building the workflow on the
# canvas, /webhook/<path> once it is activated. Leave empty to disable dispatch.
N8N_WEBHOOK_URL=
# Separate workflow for Local Offline Business searches (Google Maps data via the
# Local Business Data API). Empty disables that search type only.
N8N_LOCAL_WEBHOOK_URL=
# Listings requested per query; the upstream API bills per result.
LOCAL_SEARCH_RESULT_LIMIT=60
# Lookalike Companies workflow: one file, two Webhook nodes (step 1 discovery,
# step 2 find-contacts-for-selected). Empty disables that step only.
N8N_LOOKALIKE_DISCOVERY_WEBHOOK_URL=
N8N_LOOKALIKE_CONTACTS_WEBHOOK_URL=
# HS Code search (Advanced Filters). Empty disables it only.
N8N_HS_CODE_WEBHOOK_URL=
# Optional shared secret. Set the same value as header auth on the Webhook node.
N8N_WEBHOOK_SECRET=

# --- Radar Monitors (scheduled searches, dispatched by Celery) --------------
# Webhook of the monitor workflow (n8n_workflow/LeadPilot - Radar Monitors.json).
# Empty disables dispatch: due monitors wait, nothing is claimed.
N8N_MONITOR_WEBHOOK_URL=
# Celery broker. In compose this is the redis service; leave the default.
CELERY_BROKER_URL=redis://redis:6379/0
# How often beat looks for monitors whose random slot has come round.
MONITOR_DISPATCH_INTERVAL_SECONDS=300
# Rate control towards n8n: at most BATCH per wake-up, SPACING seconds apart.
MONITOR_DISPATCH_BATCH=10
MONITOR_DISPATCH_SPACING_SECONDS=15
# A new or resumed monitor first runs within this many minutes.
MONITOR_FIRST_RUN_DELAY_MINUTES=10
# Retry this soon when n8n could not be reached.
MONITOR_RETRY_MINUTES=30
N8N_WEBHOOK_HEADER=X-LeadPilot-Token
N8N_TIMEOUT=30

# --- Database (MySQL) --------------------------------------------------------
# MySQL listens on the server's loopback only. For local development, open the
# SSH tunnel first (.\scripts\tunnel.ps1); 127.0.0.1:3306 then forwards to it.
# Use 172.17.0.1 only when running inside a Docker container ON the server.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=leadpilot

# Overrides the assembled MySQL URL. For a zero-setup local run:
# DATABASE_URL=sqlite+aiosqlite:///./leadpilot.db
# DATABASE_URL=

SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Public base URL of this API, used to build the progress callback URL sent to
# n8n. Must be reachable FROM the n8n host (not localhost if n8n is elsewhere).
PUBLIC_API_URL=http://localhost:8000

# Google sign-in: the OAuth 2.0 Web client ID (same value as the frontend's
# VITE_GOOGLE_CLIENT_ID). Leave empty to switch "Continue with Google" off.
GOOGLE_CLIENT_ID=

# Desktop app sign-in: the *Desktop app* OAuth client ID (same value as
# GOOGLE_DESKTOP_CLIENT_ID in LeadPilot_Desktop/.env). Empty = web client only.
GOOGLE_DESKTOP_CLIENT_ID=
